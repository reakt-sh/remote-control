target Python {
  keepalive: true,
  files: ["../../train-client/src/utils/app_logger.py"]
}

reactor CameraRpi5 {
    preamble {=
        from app_logger import logger
    =}

    output frame;
    timer capture_timer(0, 100ms);

    reaction(capture_timer) -> frame {=
		buffer = b"fake_frame_data"
		frame.set(buffer)
    =}
}
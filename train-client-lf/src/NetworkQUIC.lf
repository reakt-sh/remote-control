target Python {
  keepalive: true,
  files: ["../../train-client/src/utils/app_logger.py"]
}

reactor NetworkQUIC {
    preamble {=
        from app_logger import logger
    =}

    input frame;
    input clock_synchronization;
    input heartbeat;
    output command;
    output rc_heartbeat;

	reaction (frame) {=
		self.logger.info(f"Received frame: {frame}")
	=}

	reaction (clock_synchronization) -> command {=
		self.logger.info("Received clock synchronization, sending command")
	=}

	reaction (heartbeat) -> rc_heartbeat {=
		self.logger.info("Received heartbeat, sending rc_heartbeat")
	=}
}
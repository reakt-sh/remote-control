target Python {
  keepalive: true,
  files: ["src/app_logger.py", "src/app_context.py", "src/globals.py", "src/helper.py"]
}

reactor DataStorage {
    preamble {=
        import json
        import struct
        from app_logger import logger
        from app_context import AppContext
        from globals import H264_DUMP, LATENCY_DUMP
        from helper import Helper

        appcontext = AppContext()
        helper = Helper()
    =}
	input command;
	input frame;


	reaction(startup) {=
		self.logger.info("DataStorage reactor has started.")
		self.appcontext.frame_output_file = self.helper.create_storage_file(self.H264_DUMP, "h264")
		self.appcontext.latency_command_output_file = self.helper.create_storage_file(self.LATENCY_DUMP, "log")
	=}

	reaction (command) {=
		def calculate_latency(payload):
			try:
				message = self.json.loads(payload.decode("utf-8"))
				remote_control_id = message.get("remote_control_id")
				current_time = self.helper.get_timestamp()
				remote_timestamp = message.get("remote_control_timestamp")

				# Check if clock offset has been calculated for this remote control
				if remote_control_id not in self.appcontext.clock_offsets:
					self.logger.warning(f"Clock offset not available for remote_control_id: {remote_control_id}. Cannot calculate accurate latency. Clock offsets: {self.appcontext.clock_offsets}")
					return None

				# Adjust remote timestamp to local time by subtracting clock offset
				# Clock offset = remote_time - local_time, so local_time = remote_time - clock_offset
				adjusted_remote_time = remote_timestamp - self.appcontext.clock_offsets[remote_control_id]
				curr_latency = current_time - adjusted_remote_time

				# self.logger.info(f"Remote Control Time: {remote_timestamp}\nClock Offset: {self.appcontext.clock_offsets[remote_control_id]}\nAdjusted Remote Time: {adjusted_remote_time}\nCurrent Time: {current_time}\nCalculated Latency: {latency}")


				if curr_latency is not None:
					latency_log_entry = {
						"remote_control_id": remote_control_id,
						"command_id": message.get("command_id"),
						"instruction": message.get("instruction"),
						"latency": curr_latency,
						"created_at": message.get("remote_control_timestamp"),
						"received_at": self.helper.get_timestamp(),
						"size" : len(payload),
						"target_speed": message.get("target_speed", None),
						"direction": message.get("direction", None),
						"quality": message.get("quality", None),
					}
					self.logger.info(f"Calculated latency entry: {latency_log_entry}")
					return latency_log_entry
			except Exception as e:
				self.logger.error(f"Failed to Process Latency Calculation incoming data: {e}")
				return ""
		latency_entry = calculate_latency(command.value)
		self.appcontext.latency_command_output_file.write(self.json.dumps(latency_entry) + "\n")
		self.appcontext.latency_command_output_file.flush()  # Ensure data is written to disk
	=}

	reaction (frame) {=
		frame_id, timestamp, encoded_bytes = frame.value
		self.appcontext.frame_output_file.write(encoded_bytes)
		self.appcontext.frame_output_file.flush()  # Ensure data is written to disk
	=}
}

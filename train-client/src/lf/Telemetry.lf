target Python {
  keepalive: true,
  files: ["src/app_logger.py", "src/app_context.py", "src/telemetry.py"]
}

reactor Telemetry {
    preamble {=
        import json
        from app_logger import logger
        from app_context import AppContext
        appcontext = AppContext()
    =}

    input[5] update;

    output telemetry;

    physical action act_receiving_data;

    reaction (startup) -> act_receiving_data {=

        _act = act_receiving_data
        self.appcontext.telemetryObj.telemetry_ready.connect(
            lambda msg: _act.schedule(0, msg)
        )
    =}

    reaction (act_receiving_data) -> telemetry {=
        data = act_receiving_data.value
        packet_data = self.json.dumps(data).encode("utf-8")
        telemetry.set(packet_data)
    =}
}
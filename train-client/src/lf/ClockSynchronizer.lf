target Python {
  keepalive: true,
  files: ["src/app_logger.py", "src/app_context.py", "src/globals.py", "src/helper.py"]
}

reactor ClockSynchronizer {
    preamble {=
        import json
        import struct
        from app_logger import logger
        from app_context import AppContext
        from globals import PACKET_TYPE
        from helper import Helper

        appcontext = AppContext()
        helper = Helper()
    =}

    input clock_sync_init;
    input clock_sync_recv;
    output clock_sync_send;

    logical action synchronize_clock;
    state counter = 0;

    reaction (clock_sync_init) -> synchronize_clock {=
        self.logger.info("Clock synchronization initiated.")
        self.counter = self.appcontext.number_of_rtt_packets
        synchronize_clock.schedule(SEC(2), None)  # Start the synchronization process after a short delay
    =}

    reaction (synchronize_clock) -> clock_sync_send {=
        def create_clock_sync_packet():
            rtt_train_Packet = {
                "type": "rtt_train",
                "remote_control_timestamp": 0,
                "remote_control_id": self.appcontext.remote_control_client_id,
                "train_timestamp": self.helper.get_timestamp()
            }
            rtt_train_data = self.json.dumps(rtt_train_Packet).encode("utf-8")
            rtt_train_packet = self.struct.pack("B", self.PACKET_TYPE["rtt_train"]) + rtt_train_data
            rtt_train_packet = self.helper.get_length_prefixed_packet(rtt_train_packet)
            return rtt_train_packet


        packet = create_clock_sync_packet()
        clock_sync_send.set(packet)
        self.counter -= 1
        if self.counter > 0:  # Limit the number of synchronization attempts
            synchronize_clock.schedule(MSEC(200), None)  # Schedule next synchronization attempt after a short delay
        else:
            self.logger.info("Clock synchronization completed.")

    =}

    reaction (clock_sync_recv) -> clock_sync_send {=
        try:
            payload = clock_sync_recv.value
            message = self.json.loads(payload.decode("utf-8"))

            if message.get("type") == "rtt":
                try:
                    # just modify event data with current timestamp
                    rtt_data = self.json.loads(payload.decode("utf-8"))
                    rtt_data["train_timestamp"] = self.helper.get_timestamp()
                    rtt_packet = self.json.dumps(rtt_data).encode("utf-8")
                    rtt_packet = self.struct.pack("B", self.PACKET_TYPE["rtt"]) + rtt_packet
                    rtt_packet = self.helper.get_length_prefixed_packet(rtt_packet)
                    clock_sync_send.set(rtt_packet)
                except self.json.JSONDecodeError as e:
                    self.logger.error(f"Failed to parse rtt JSON: {e}")
            elif message.get("type") == "rtt_train":
                try:
                    jsonString = payload.decode("utf-8")
                    jsonData = self.json.loads(jsonString)

                    # Extract timestamps
                    remote_control_timestamp = jsonData.get("remote_control_timestamp")
                    train_timestamp_sent = jsonData.get("train_timestamp")
                    current_time = self.helper.get_timestamp()
                    remote_control_id = jsonData.get("remote_control_id")

                    # Calculate RTT (Round Trip Time)
                    rtt = current_time - train_timestamp_sent

                    # Calculate clock offset
                    # Clock offset = remote_time - local_time (at the midpoint of RTT)
                    # Approximation: remote_control_timestamp was captured at roughly (train_timestamp_sent + rtt/2)
                    clock_offset = remote_control_timestamp - (train_timestamp_sent + rtt / 2)

                    # Collect offset samples per remote and compute average after N samples
                    samples = self.appcontext.clock_offset_samples.setdefault(remote_control_id, [])
                    samples.append(clock_offset)

                    self.logger.info(
                        f"RTT packet received - "
                        f"RTT: {rtt}ms, "
                        f"Clock Offset sample: {clock_offset:.2f}ms, "
                        f"Sample count for {remote_control_id}: {len(samples)}/{self.appcontext.number_of_rtt_packets}, "
                        f"Remote timestamp: {remote_control_timestamp}, "
                        f"Train timestamp sent: {train_timestamp_sent}, "
                        f"Current time: {current_time}"
                    )

                    if len(samples) >= self.appcontext.number_of_rtt_packets:
                        avg_offset = sum(samples[:self.appcontext.number_of_rtt_packets]) / self.appcontext.number_of_rtt_packets
                        avg_offset = round(avg_offset)
                        self.appcontext.clock_offsets[remote_control_id] = avg_offset
                        self.logger.info(
                            f"Clock offset established for {remote_control_id}: {avg_offset:.2f}ms "
                            f"(averaged over {self.appcontext.number_of_rtt_packets} RTT samples)"
                        )
                        # Reset samples to avoid unbounded growth; new ACK can re-initiate measurement
                        self.appcontext.clock_offset_samples[remote_control_id] = []
                except Exception as e:
                    self.logger.error(f"Failed to decode clock sync message: {e}")
            else:
                self.logger.warning(f"Received unknown packet type in clock sync: {packet_type}")

        except Exception as e:
            self.logger.error(f"Failed to process clock sync response: {e}")
    =}

}
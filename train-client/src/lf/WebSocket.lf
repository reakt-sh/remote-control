target Python {
  keepalive: true,
  files: ["src/app_logger.py", "src/network_worker_ws.py", "src/globals.py", "src/video_config.py", "src/app_context.py"]
}

reactor WebSocket {
    preamble {=
        from app_logger import logger
        from app_context import AppContext
        from network_worker_ws import NetworkWorkerWS
    =}

    output receiving_data;

    physical action act_receiving_data;

    reaction (startup) -> act_receiving_data {=
        context = self.AppContext()
        train_client_id = context.train_client_id

        self.logger.info(f"WebSocket reactor started for train client ID: {train_client_id}")
        self.network_worker = self.NetworkWorkerWS(train_client_id)

        _act = act_receiving_data
        self.network_worker.recieved_data.connect(
            lambda msg: _act.schedule(0, msg)
        )
        self.network_worker.start()
    =}

    reaction (act_receiving_data) -> receiving_data {=
        data = act_receiving_data.value
        self.logger.info(f"Received data from network worker: {data}")
        receiving_data.set(data)
    =}
}
target Python {
  keepalive: true,
  files: ["src/app_logger.py", "src/network_worker_quic.py", "src/globals.py", "src/video_config.py", "src/app_context.py"]
}

reactor NetworkQUIC(train_client_id = "") {
    preamble {=
        from app_logger import logger
        from app_context import AppContext
        from network_worker_quic import NetworkWorkerQUIC
    =}

    input frame;
    input[2] sending_data;
    output receiving_data;

    physical action act_receiving_data;

    reaction (startup) -> act_receiving_data {=
        context = self.AppContext()
        train_client_id = context.train_client_id

        self.logger.info(f"NetworkQUIC reactor started for train client ID: {train_client_id}")
        self.network_worker = self.NetworkWorkerQUIC(train_client_id)

        self.network_worker.stream_data.connect(
            lambda msg: self.act_receiving_data.schedule(0, msg)
        )
        self.network_worker.start()
    =}

    reaction (frame) {=
        self.logger.info(f"Received frame: {frame.value}")
    =}

    reaction (sending_data) {=
        self.logger.info(f"Received data to send, enqueuing to network worker: {sending_data.value}")
    =}

    reaction (act_receiving_data) {=
        data = act_receiving_data.value
        self.logger.info(f"Received data from network worker: {data}")
        self.receiving_data.emit(data)
    =}
}
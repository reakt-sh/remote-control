target Python {
  keepalive: true,
  files: ["src/app_logger.py", "src/helper.py"]
}

import NetworkQUIC from "NetworkQUIC.lf";
import Camera from "Camera.lf";
import Motor from "Motor.lf";
import LatencyCalculator from "LatencyCalculator.lf";
import ClockSynchronizer from "ClockSynchronizer.lf";
import DataStorage from "DataStorage.lf";
import Parser from "Parser.lf";
import EmergencyBreak from "EmergencyBreak.lf";
import HeartbeatHandler from "HeartbeatHandler.lf";

// import Encoder from "Encoder.lf";


main reactor TrainClient {
    preamble {=
		from app_logger import logger
		from helper import Helper
		helper = Helper()
		train_client_id = helper.get_uuid()
    =}

    camera = new Camera();
    quic = new NetworkQUIC(train_client_id = {= self.train_client_id =});
    motor = new Motor();
    // encoder = new Encoder();
    latency_calculator = new LatencyCalculator();
    clock_synchronizer = new ClockSynchronizer();
    data_storage = new DataStorage();
    parser = new Parser();
    emergency_break = new EmergencyBreak();
    heartbeat_handler = new HeartbeatHandler();

    camera.frame -> quic.frame;
    quic.receiving_data -> parser.data;
	parser.heartbeat -> heartbeat_handler.heartbeat_recv;
	parser.clock_sync -> clock_synchronizer.clock_sync_recv;
	parser.command -> latency_calculator.command;
	heartbeat_handler.heartbeat_timout -> emergency_break.heartbeat_timeout;
	emergency_break.motor_control , parser.command -> motor.motor_control;

	clock_synchronizer.clock_sync_send, heartbeat_handler.heartbeat_send -> quic.sending_data;

    latency_calculator.latency -> data_storage.latency;
}
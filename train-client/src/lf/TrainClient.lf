target Python {
  keepalive: true,
  files: ["src/app_logger.py", "src/helper.py", "src/app_context.py", "src/telemetry.py"]
}

import QUIC from "QUIC.lf";
import WebSocket from "WebSocket.lf";
import Camera from "Camera.lf";
import Motor from "Motor.lf";
import LatencyCalculator from "LatencyCalculator.lf";
import ClockSynchronizer from "ClockSynchronizer.lf";
import DataStorage from "DataStorage.lf";
import Parser from "Parser.lf";
import EmergencyBrake from "EmergencyBrake.lf";
import HeartbeatHandler from "HeartbeatHandler.lf";
import Encoder from "Encoder.lf";
import CommandProcessor from "CommandProcessor.lf";
import Telemetry from "Telemetry.lf";
import MQTT from "MQTT.lf";


main reactor TrainClient {
    preamble {=
		from app_logger import logger
		from helper import Helper
		from app_context import AppContext

		logger.info("TrainClient is starting up.")
		app_context = AppContext()
		helper = Helper()
		app_context.train_client_id = helper.get_uuid()
		app_context.init_telemetry()
		logger.info(f"Assigned Train Client ID: {app_context.train_client_id}")
    =}

    camera = new Camera();
	parser = new Parser();
    motor = new Motor();
    encoder = new Encoder();
    latency_calculator = new LatencyCalculator();
    clock_synchronizer = new ClockSynchronizer();
    data_storage = new DataStorage();
    emergency_brake = new EmergencyBrake();
    heartbeat_handler = new HeartbeatHandler();
	command_processor = new CommandProcessor();
	quic = new QUIC();
	ws = new WebSocket();
	telemetry = new Telemetry();
	mqtt = new MQTT();

	clock_synchronizer.clock_sync_send, heartbeat_handler.heartbeat_send -> quic.sending_data;
	parser.command -> latency_calculator.command;
	parser.command -> command_processor.command;
	parser.connect -> clock_synchronizer.clock_sync_init;
	parser.connect -> heartbeat_handler.heartbeat_init;
	parser.disconnect -> heartbeat_handler.heartbeat_stop;
	parser.clock_sync -> clock_synchronizer.clock_sync_recv;
	parser.heartbeat -> heartbeat_handler.heartbeat_recv;

    quic.receiving_data, ws.receiving_data -> parser.data;

	heartbeat_handler.heartbeat_timout -> emergency_brake.heartbeat_timeout;

    latency_calculator.latency -> data_storage.latency;
	camera.frame -> encoder.raw_frame;
	encoder.encoded_frame -> data_storage.frame;
	encoder.encoded_frame -> quic.frame;

	telemetry.telemetry -> mqtt.data;


	command_processor.target_speed,
	command_processor.direction,
	command_processor.start,
	command_processor.stop,
	command_processor.headlight_on,
	command_processor.headlight_off,
	command_processor.horn_on,
	command_processor.horn_off,
	emergency_brake.stop -> motor.actuate;

	command_processor.target_speed,
	command_processor.direction,
	command_processor.start,
	command_processor.stop,
	command_processor.headlight_on,
	command_processor.headlight_off,
	command_processor.horn_on,
	command_processor.horn_off,
	emergency_brake.stop,
	motor.current_speed -> telemetry.update;
}
target Python {
  keepalive: true,
  files: ["src/app_logger.py"]
}

reactor EmergencyBrake {
    preamble {=
        from app_logger import logger
    =}
    input heartbeat_timeout;
    output stop;

    reaction(heartbeat_timeout) -> stop {=
        self.logger.warning("Emergency brake activated due to heartbeat timeout")
        stop.set(("POWER_OFF", True))
    =}
}


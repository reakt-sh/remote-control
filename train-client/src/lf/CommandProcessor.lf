target Python {
  keepalive: true,
  files: ["src/app_logger.py", "src/globals.py", "src/app_context.py"]
}

reactor CommandProcessor {
    preamble {=
        import json
        from app_logger import logger
        from globals import PACKET_TYPE, TRAIN_STATUS, DIRECTION, MAX_SPEED
        from app_context import AppContext
        appcontext = AppContext()
    =}

	input command;

	output target_speed;
    output direction;
	output start;
	output stop;
    output headlight_on;
    output headlight_off;
    output horn_on;
    output horn_off;

    reaction (command) -> target_speed, direction, start, stop, headlight_on, headlight_off, horn_on, horn_off {=
        payload = command.value
        self.logger.info(f"Received command: {payload}")

        try:
            message = self.json.loads(payload.decode("utf-8"))
            remote_control_id = message.get("remote_control_id")

            if message["instruction" ] == "CHANGE_TARGET_SPEED":
                self.appcontext.target_speed_value = message["target_speed"]
                self.appcontext.target_speed_value = min(self.appcontext.target_speed_value, self.MAX_SPEED)
                target_speed.set((message["instruction"], self.appcontext.target_speed_value))
            elif message["instruction" ] == "STOP_SENDING_DATA":
                # if self.is_sending:
                #     self.toggle_sending()
                pass
            elif message["instruction" ] == "START_SENDING_DATA":
                # if not self.is_sending:
                #     self.toggle_sending()
                pass
            elif message["instruction" ] == "POWER_ON":
                start.set((message["instruction"], True))
            elif message["instruction" ] == "POWER_OFF":
                stop.set((message["instruction"], True))
            elif message["instruction" ] == "CHANGE_DIRECTION":
                direction_value = self.DIRECTION[message.get("direction")]
                direction.set((message["instruction"], direction_value))
            elif message["instruction" ] == "CALCULATE_NETWORK_SPEED":
                # self.networkspeed.start()
                pass
            elif message["instruction" ] == "HEADLIGHT_ON":
                headlight_on.set((message["instruction"], True))
            elif message["instruction" ] == "HEADLIGHT_OFF":
                headlight_off.set((message["instruction"], True))
            elif message["instruction" ] == "HORN_ON":
                horn_on.set((message["instruction"], True))
            elif message["instruction" ] == "HORN_OFF":
                horn_off.set((message["instruction"], True))
            elif message["instruction" ] == "CHANGE_VIDEO_QUALITY":
                # video_quality = message.get("quality")
                # logger.info(f"Video quality is changing to {video_quality}")
                # if video_quality ==  "low":
                #     logger.info(f"Setting encoder bitrate to LOW_BITRATE: {LOW_BITRATE}")
                #     self.encoder.set_bitrate(LOW_BITRATE)
                # elif video_quality == "medium":
                #     logger.info(f"Setting encoder bitrate to MEDIUM_BITRATE: {MEDIUM_BITRATE}")
                #     self.encoder.set_bitrate(MEDIUM_BITRATE)
                # elif video_quality == "high":
                #     logger.info(f"Setting encoder bitrate to HIGH_BITRATE: {HIGH_BITRATE}")
                #     self.encoder.set_bitrate(HIGH_BITRATE)
                # else:
                #     logger.warning(f"Unknown video quality: {video_quality}")
                pass
            elif message["instruction" ] == "SWITCH_PROTOCOL":
                # protocol = message.get("protocol", "").upper()
                # if protocol in ["WEBSOCKET", "QUIC", "WEBRTC"]:
                #     self.switch_protocol(protocol)
                # else:
                #     logger.warning(f"Unknown protocol: {protocol}")
                pass
            else:
                logger.warning(f"Unknown instruction: {message['instruction']}")
        except Exception as e:
            self.logger.error(f"Error processing command: {e}")
    =}
}
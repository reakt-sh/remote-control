            "targets": [
                {
                    "datasource": {
                        "type": "influxdb",
                        "uid": "${DS_INFLUXDB_SQL}"
                    },
                    "refId": "A",
                    "format": "table",
                    "rawSql": "WITH current_session AS (SELECT session_id FROM clock_rc ORDER BY time DESC LIMIT 1) SELECT 'clock_rc' AS measurement, COUNT(*) AS total_records FROM clock_rc WHERE session_id = (SELECT session_id FROM current_session) UNION ALL SELECT 'clock_train' AS measurement, COUNT(*) AS total_records FROM clock_train WHERE session_id = (SELECT session_id FROM current_session) UNION ALL SELECT 'telemetry_latency' AS measurement, COUNT(*) AS total_records FROM telemetry_latency WHERE session_id = (SELECT session_id FROM current_session) UNION ALL SELECT 'frame_latency' AS measurement, COUNT(*) AS total_records FROM frame_latency WHERE session_id = (SELECT session_id FROM current_session) UNION ALL SELECT 'command_latency' AS measurement, COUNT(*) AS total_records FROM command_latency WHERE session_id = (SELECT session_id FROM current_session) UNION ALL SELECT 'wan' AS measurement, COUNT(*) AS total_records FROM wan WHERE session_id = (SELECT session_id FROM current_session)",
                    "editorMode": "code"
                }
            ]
        }
